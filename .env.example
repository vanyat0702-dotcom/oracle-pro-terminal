# ORACLE PRO TERMINAL — шаблон переменных окружения
# Скопируйте этот файл в .env и заполните реальными значениями.
# Файл .env коммитить нельзя (см. .gitignore). Значения секретов в репозитории не хранятся.

# OpenAI API — используется в api/analyze.ts, api/brain.ts, ai-consensus.js
OPENAI_API_KEY=

# Google Gemini API — используется в api/analyze.ts, ai-consensus.js
GEMINI_API_KEY=

# Telegram Bot — используется в api/analyze.ts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Порт локального Express-сервера (server.js). Не секрет.
# PORT=3000
